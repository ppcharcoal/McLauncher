{
  "name": "mclauncher",
  "productName": "McLauncher",
  "version": "0.3.0",
  "description": "A simple, fast Minecraft launcher with Fabric, Modrinth and CurseForge support",
  "main": "src/main/main.js",
  "author": "ppcharcoal <pipesior@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ppcharcoal/McLauncher",
  "scripts": {
    "start": "electron .",
    "test": "node test/unit.js",
    "dist": "electron-builder --linux pacman AppImage tar.gz --publish never",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.ppcharcoal.mclauncher",
    "productName": "McLauncher",
    "executableName": "mclauncher",
    "artifactName": "mclauncher-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "pacman",
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Simple Minecraft launcher with Fabric and mod browser",
      "desktop": {
        "entry": {
          "StartupWMClass": "mclauncher",
          "Keywords": "minecraft;fabric;mods;"
        }
      }
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "xdg-utils",
        "libnotify",
        "xorg-xrandr"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "McLauncher"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "McLauncher",
      "artifactName": "mclauncher-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "mclauncher-${version}-portable.${ext}"
    }
  }
}
